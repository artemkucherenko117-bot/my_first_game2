extends Area2D # Кислотна лужа є небезпечною зоною.
var player_inside := false # Зберігаємо стан перебування гравця в кислоті.
func _ready() -> void: # Виконуємо підключення сигналів після створення вузла.
    body_entered.connect(_on_body_entered) # Підключаємо сигнал входження тіла.
    body_exited.connect(_on_body_exited) # Підключаємо сигнал виходу тіла.
func _on_body_entered(body: Node2D) -> void: # Обробляємо вхід тіла в кислоту.
    if not body is Player or player_inside: # Реагуємо лише на Player і не повторюємо повідомлення.
        return # Завершуємо обробник без дій.
    player_inside = true # Позначаємо, що гравець перебуває в кислоті.
    print("ВНИМАНИЕ: Игрок наступил в кислоту! Получение периодического урона.") # Виводимо попередження.
func _on_body_exited(body: Node2D) -> void: # Обробляємо вихід тіла із зони.
    if not body is Player: # Ігноруємо всі тіла, крім гравця.
        return # Завершуємо обробник.
    player_inside = false # Позначаємо, що гравець покинув кислоту.
    print("Игрок покинул зону кислоты. Угроза устранена.") # Виводимо повідомлення про безпеку.
